# Workspace secrets live in the parent directory (shunkan-workspace), not in git.
# direnv find_up walks from this worktree to that parent.

SECRETS_FILE=$(find_up .secrets.env)
if [[ ! -f "$SECRETS_FILE" ]]; then
	SECRETS_FILE=$(find_up secrets.env)
fi
if [[ -f "$SECRETS_FILE" ]]; then
	dotenv "$SECRETS_FILE"
else
	log_error "secrets env not found in current or parent directories (expected .secrets.env)"
	exit 1
fi

SECRETS_DIR="$(dirname "$SECRETS_FILE")"
SECRETS_PROD_FILE="${SECRETS_DIR}/.secrets.prod.env"
if [[ ! -f "$SECRETS_PROD_FILE" ]]; then
	SECRETS_PROD_FILE="${SECRETS_DIR}/secrets.prod.env"
fi
watch_file "${SECRETS_DIR}/.secrets.env"
watch_file "${SECRETS_DIR}/.secrets.prod.env"
if [[ -f "$SECRETS_PROD_FILE" ]]; then
	dotenv "$SECRETS_PROD_FILE"
fi

WORKTREE_ROOT=$(git rev-parse --show-toplevel 2>/dev/null)
if [[ -z "$WORKTREE_ROOT" ]]; then
	log_error "git root not found"
	exit 1
fi
REPO_ROOT=$(dirname "$WORKTREE_ROOT")
REPO_NAME=$(basename "$REPO_ROOT")
WORKTREE_ID=$(basename "$WORKTREE_ROOT")
BRANCH_ID=$(git branch --show-current 2>/dev/null)
PROJECT_ID=$(git remote get-url origin 2>/dev/null || true)
if [[ -z "$PROJECT_ID" ]]; then
	PROJECT_ID=$(git rev-parse --git-common-dir 2>/dev/null)
fi

# Port offset. Primary main/master checkouts stay on 0. Other branches take
# hash % 29 + 1 so sibling worktrees do not share Discord redirect ports.
shunkan_port_offset_preferred() {
	local worktree_id=$1 branch=$2
	local offset
	if [[ "$worktree_id" == "dev" || "$branch" == "main" || "$branch" == "master" ]]; then
		printf '0'
		return 0
	fi
	offset=$(printf '%s' "${PROJECT_ID}:${worktree_id}" | cksum | cut -d' ' -f1)
	printf '%s' $((offset % 29 + 1))
}

shunkan_port_offset_assign() {
	local -A taken=()
	local -a names=()
	local path="" wt="" branch="" preferred offset entry rest ref

	flush_wt() {
		if [[ -n "$path" ]]; then
			names+=("${wt}|${path}|${branch}")
		fi
		path=""
		wt=""
		branch=""
	}

	while IFS= read -r line; do
		case "$line" in
			worktree\ *)
				flush_wt
				path=${line#worktree }
				wt=$(basename "$path")
				;;
			branch\ *)
				ref=${line#branch }
				branch=${ref#refs/heads/}
				;;
			detached)
				branch=""
				;;
			"")
				flush_wt
				;;
		esac
	done < <(git -C "$WORKTREE_ROOT" worktree list --porcelain 2>/dev/null)
	flush_wt

	local sorted
	mapfile -t sorted < <(printf '%s\n' "${names[@]}" | LC_ALL=C sort)

	for entry in "${sorted[@]}"; do
		[[ -n "$entry" ]] || continue
		wt=${entry%%|*}
		rest=${entry#*|}
		path=${rest%%|*}
		branch=${rest#*|}
		preferred=$(shunkan_port_offset_preferred "$wt" "$branch")
		offset=$preferred
		if [[ "$preferred" != "0" ]]; then
			local started=$offset
			while [[ -n "${taken[$offset]:-}" ]]; do
				offset=$((offset % 29 + 1))
				if [[ "$offset" -eq "$started" ]]; then
					break
				fi
			done
		fi
		taken[$offset]=1
		if [[ "$wt" == "$WORKTREE_ID" ]]; then
			printf '%s' "$offset"
			return 0
		fi
	done

	shunkan_port_offset_preferred "$WORKTREE_ID" "$BRANCH_ID"
}

if [[ -n "${PORT_OFFSET+x}" ]]; then
	:
else
	preferred=$(shunkan_port_offset_preferred "$WORKTREE_ID" "$BRANCH_ID")
	if [[ "$preferred" == "0" ]]; then
		PORT_OFFSET=0
	else
		PORT_OFFSET=$(shunkan_port_offset_assign)
	fi
fi
export PORT_OFFSET

COMPOSE_PROJECT_NAME=$(printf '%s' "${REPO_NAME}_${WORKTREE_ID}" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9_-' '_')
export COMPOSE_PROJECT_NAME
export PM2_HOME="${WORKTREE_ROOT}/.pm2"

export APP_PORT=$((3000 + PORT_OFFSET))
export PORT="$APP_PORT"
export MONGO_PORT=$((27017 + PORT_OFFSET))
export SILO_PORT=$((9000 + PORT_OFFSET))
export SILO_CONSOLE_PORT=$((9100 + PORT_OFFSET))

shunkan_dev_external_host() {
	local host=""
	if command -v tailscale >/dev/null 2>&1; then
		host=$(tailscale status --json 2>/dev/null | python3 -c 'import json,sys
try:
    data=json.load(sys.stdin)
except Exception:
    raise SystemExit
name=((data.get("Self") or {}).get("DNSName") or "").rstrip(".")
if name:
    print(name)
' 2>/dev/null || true)
	fi
	if [[ -n "$host" ]]; then
		printf '%s' "$host"
	else
		hostname -s
	fi
}

export DEV_EXTERNAL_HOST="${DEV_EXTERNAL_HOST:-$(shunkan_dev_external_host)}"
if [[ "${DEV_EXTERNAL_HOST}" == *.ts.net ]]; then
	export DEV_PUBLIC_SCHEME=https
else
	export DEV_PUBLIC_SCHEME=http
fi
export DEV_SERVICE_HOST="${DEV_SERVICE_HOST:-127.0.0.1}"

export DATABASE_NAME=shunkan
export MONGODB_URI="mongodb://${DEV_SERVICE_HOST}:${MONGO_PORT}/${DATABASE_NAME}?replicaSet=rs0&directConnection=true"

export S3_ACCESS_KEY_ID="${S3_ACCESS_KEY_ID:-siloadmin}"
export S3_SECRET_ACCESS_KEY="${S3_SECRET_ACCESS_KEY:-silo-local-dev}"
export S3_ENDPOINT="http://${DEV_SERVICE_HOST}:${SILO_PORT}"
export S3_REGION="${S3_REGION:-us-east-1}"
export S3_BUCKET="${S3_BUCKET:-shunkan}"
export S3_PRIVATE_BUCKET="${S3_PRIVATE_BUCKET:-shunkan-private}"

export NEXT_PUBLIC_URL="${DEV_PUBLIC_SCHEME}://${DEV_EXTERNAL_HOST}:${APP_PORT}"
export NEXT_PUBLIC_SERVER_URL="$NEXT_PUBLIC_URL"
export NEXT_PUBLIC_BETTER_AUTH_URL="$NEXT_PUBLIC_URL"

log_status "${REPO_NAME}/${WORKTREE_ID} offset ${PORT_OFFSET} · ${NEXT_PUBLIC_URL} · mongo ${DATABASE_NAME}:${MONGO_PORT} · silo ${SILO_PORT}"
